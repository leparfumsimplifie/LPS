{%- doc -%}
  Minimal line icons used by `lps-*` sections.

  @param {string} icon - 'arrow' | 'check' | 'dash'
{%- enddoc -%}
{%- case icon -%}
  {%- when 'arrow' -%}
    <svg class="lps-arrow" viewBox="0 0 22 12" fill="none" aria-hidden="true" focusable="false"><path d="M0 6h20M15 1l5 5-5 5" stroke="currentColor" stroke-width="1"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 8.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="1.25"/></svg>
  {%- when 'dash' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M4 8h8" stroke="currentColor" stroke-width="1.25"/></svg>
{%- endcase -%}
