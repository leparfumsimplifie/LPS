{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
-%}
<section
  id="{{ anchor }}"
  class="lps lps-faq lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px;"
>
  <div class="lps-container">
    <div class="lps-curriculum__grid">
      <div class="lps-curriculum__aside">
        {% render 'lps-intro', index: s.index, eyebrow: s.eyebrow, heading: s.heading, text: s.text %}
        {%- if s.support_text != blank -%}
          <div class="lps-rte lps-rte--sm" data-lps-reveal>{{ s.support_text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <div class="lps-actions">
            <a class="lps-link" href="{{ s.button_link | default: '/pages/contact' }}">{{ s.button_label }}{% render 'lps-icon', icon: 'arrow' %}</a>
          </div>
        {%- endif -%}
      </div>

      <div class="lps-modules">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <details class="lps-details lps-details--faq" {{ block.shopify_attributes }}>
            <summary>
              <span class="lps-details__title">{{ b.question }}</span>
              <span class="lps-details__icon" aria-hidden="true"></span>
            </summary>
            <div class="lps-details__content">
              <div class="lps-rte">{{ b.answer }}</div>
              {% render 'lps-confirm', note: b.confirm_note %}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if s.structured_data -%}
    {%- capture faq_entities -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.include_in_search -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          },
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign faq_entities = faq_entities | strip -%}
    {%- if faq_entities != blank -%}
      {%- assign faq_size = faq_entities | size | minus: 1 -%}
      <script type="application/ld+json">
        {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{{ faq_entities | slice: 0, faq_size }}]}
      </script>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "LPS · FAQ",
  "tag": "div",
  "class": "lps-section",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Section number"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "richtext",
      "id": "support_text",
      "label": "Support text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "Add FAQ structured data for search engines",
      "info": "Only questions marked 'Include in search results' are added.",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "charcoal",
          "label": "Charcoal"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Optional. Lets buttons link to this section, e.g. #curriculum"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        },
        {
          "type": "checkbox",
          "id": "include_in_search",
          "label": "Include in search results",
          "info": "Turn on once the answer is confirmed.",
          "default": false
        },
        {
          "type": "textarea",
          "id": "confirm_note",
          "label": "Editor note (never shown to customers)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LPS · FAQ",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
