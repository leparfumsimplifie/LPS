{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
-%}
<section
  id="{{ anchor }}"
  class="lps lps-gallery lps-gallery--{{ s.layout }} lps-gallery--count-{{ section.blocks.size }} lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px;"
>
  <div class="lps-container">
    {%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
      <div class="lps-section-head{% if s.align == 'center' %} lps-section-head--center{% endif %}">
        {% render 'lps-intro', eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: s.align %}
      </div>
    {%- endif -%}

    <div class="lps-gallery__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          if b.image == blank and b.image_stock == 'none' and request.design_mode == false
            continue
          endif
          if s.layout == 'strip'
            assign ratio = '4 / 5'
            assign sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 70vw'
          else
            case b.shape
              when 'large'
                assign sizes = '(min-width: 750px) 50vw, 100vw'
              when 'wide'
                assign sizes = '(min-width: 750px) 50vw, 100vw'
              else
                assign sizes = '(min-width: 750px) 25vw, 50vw'
            endcase
            assign ratio = ''
          endif
        -%}
        <figure class="lps-gallery__item lps-gallery__item--{{ b.shape }}" role="listitem" data-lps-reveal {{ block.shopify_attributes }}>
          {% render 'lps-media', image: b.image, stock: b.image_stock, alt: b.image_alt, brief: b.caption, ratio: ratio, sizes: sizes %}
          {%- if b.caption != blank -%}
            <figcaption class="lps-media__caption">{{ b.caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

    {%- if s.footnote != blank -%}
      <p class="lps-note" style="margin-top: 1.5rem;">{{ s.footnote }}</p>
    {%- endif -%}
  </div>
</section>

