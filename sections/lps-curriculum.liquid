{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
-%}
<section
  id="{{ anchor }}"
  class="lps lps-curriculum lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px;"
>
  <div class="lps-container">
    <div class="lps-curriculum__grid">
      <div class="lps-curriculum__aside">
        {% render 'lps-intro', index: s.index, eyebrow: s.eyebrow, heading: s.heading, text: s.text %}
        {%- if s.image != blank or s.image_stock != 'none' or request.design_mode and s.image_brief != blank -%}
          <figure class="lps-figure" data-lps-reveal>
            {% render 'lps-media', image: s.image, stock: s.image_stock, alt: s.image_alt, brief: s.image_brief, label: s.placeholder_label, ratio: '4 / 3', sizes: '(min-width: 990px) 33vw, 100vw', zoom: true %}
            {%- if s.caption != blank -%}
              <figcaption class="lps-media__caption">{{ s.caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <div class="lps-actions">
            <a class="lps-btn lps-btn--secondary" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
          </div>
        {%- endif -%}
        {% render 'lps-confirm', note: s.confirm_note %}
      </div>

      <lps-modules class="lps-curriculum__modules">
        {%- if section.blocks.size > 1 -%}
          <div class="lps-modules__tools">
            <button
              type="button"
              class="lps-modules__toggle"
              data-lps-toggle-all
              data-label-expand="Expand all modules"
              data-label-collapse="Collapse all modules"
              aria-expanded="false"
              hidden
            >
              Expand all modules
            </button>
          </div>
        {%- endif -%}
        <div class="lps-modules">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <details class="lps-details" {% if b.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>
                <span class="lps-details__index">{{ b.number | default: forloop.index }}</span>
                <span>
                  <span class="lps-details__title">{{ b.title }}</span>
                  {%- if b.status == 'soon' -%}
                    <span class="lps-badge lps-badge--soon lps-tag">{{ s.soon_label }}</span>
                  {%- endif -%}
                  {%- if b.summary != blank -%}
                    <span class="lps-details__summary-text">{{ b.summary }}</span>
                  {%- endif -%}
                </span>
                <span class="lps-details__icon" aria-hidden="true"></span>
              </summary>
              {%- if b.content != blank or b.confirm_note != blank -%}
                <div class="lps-details__content">
                  <div class="lps-rte">{{ b.content }}</div>
                  {% render 'lps-confirm', note: b.confirm_note %}
                </div>
              {%- endif -%}
            </details>
          {%- endfor -%}
        </div>
        {%- if s.footnote != blank -%}
          <p class="lps-note" style="margin-top: 1.25rem;">{{ s.footnote }}</p>
        {%- endif -%}
      </lps-modules>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LPS · Curriculum",
  "tag": "div",
  "class": "lps-section",
  "settings": [
    {
      "type": "text",
      "id": "index",
