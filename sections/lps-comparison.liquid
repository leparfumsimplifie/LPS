{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
-%}
<section
  id="{{ anchor }}"
  class="lps lps-comparison lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px;"
>
  <div class="lps-container lps-container--narrow">
    <div class="lps-section-head lps-section-head--center">
      {% render 'lps-intro', index: s.index, eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: 'center' %}
    </div>

    <div data-lps-reveal>
      <table class="lps-compare">
        {%- if s.caption != blank -%}
          <caption>{{ s.caption }}</caption>
        {%- endif -%}
        <thead>
          <tr>
            <th scope="col"><span class="lps-visually-hidden">Feature</span></th>
            <th scope="col">
              {{ s.free_title }}
              {%- if s.free_subtitle != blank -%}<small>{{ s.free_subtitle }}</small>{%- endif -%}
            </th>
            <th scope="col" class="lps-compare__premium">
              {{ s.premium_title }}
              {%- if s.product != blank -%}
                <small>{{ s.product.price | money }}{% if s.premium_subtitle != blank %} · {{ s.premium_subtitle }}{% endif %}</small>
              {%- elsif s.premium_subtitle != blank -%}
                <small>{{ s.premium_subtitle }}</small>
              {%- endif -%}
            </th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">
                {{ b.feature }}
                {% render 'lps-confirm', note: b.confirm_note %}
              </th>
              {%- for col in (1..2) -%}
                {%- liquid
                  if col == 1
                    assign value = b.free
                    assign note = b.free_note
                    assign cell_class = ''
                  else
                    assign value = b.premium
                    assign note = b.premium_note
                    assign cell_class = 'lps-compare__premium'
                  endif
                -%}
                <td class="{{ cell_class }}">
                  {%- case value -%}
                    {%- when 'yes' -%}
                      <span class="lps-compare__yes">{% render 'lps-icon', icon: 'check' %}<span>{{ note | default: 'Included' }}</span></span>
                    {%- when 'no' -%}
                      <span class="lps-compare__no">{% render 'lps-icon', icon: 'dash' %}<span>{{ note | default: 'Not included' }}</span></span>
                    {%- else -%}
                      {{ note }}
                  {%- endcase -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if s.button_label != blank -%}
      <div class="lps-actions" style="justify-content: center; margin-top: 2.5rem;">
        <a class="lps-btn" href="{{ s.button_link | default: s.product.url | default: '#' }}">{{ s.button_label }}</a>
      </div>
    {%- endif -%}
    {% render 'lps-confirm', note: s.confirm_note %}
  </div>
</section>

{% schema %}
{
  "name": "LPS · Free vs Premium",
  "tag": "div",
  "class": "lps-section",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Section number"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Free and Premium"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "free_title",
      "label": "First column title",
      "default": "Free community"
    },
    {
      "type": "text",
      "id": "free_subtitle",
      "label": "First column subtitle",
      "default": "No charge"
    },
    {
      "type": "text",
      "id": "premium_title",
      "label": "Second column title",
      "default": "Premium Learning"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Membership product",
      "info": "Shows the live Shopify price under the column title."
    },
    {
      "type": "text",
      "id": "premium_subtitle",
      "label": "Second column subtitle",
      "default": "One-time payment"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Table caption"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank to link to the membership product."
    },
    {
      "type": "textarea",
      "id": "confirm_note",
      "label": "Editor note (never shown to customers)"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "charcoal",
          "label": "Charcoal"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Optional. Lets buttons link to this section, e.g. #curriculum"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Feature"
        },
        {
          "type": "select",
          "id": "free",
          "label": "Free",
          "options": [
            {
              "value": "yes",
              "label": "Included"
            },
            {
              "value": "no",
              "label": "Not included"
            },
            {
              "value": "text",
              "label": "Text only"
            }
          ],
          "default": "yes"
        },
        {
          "type": "text",
          "id": "free_note",
          "label": "Free — text"
        },
        {
          "type": "select",
          "id": "premium",
          "label": "Premium",
          "options": [
            {
              "value": "yes",
              "label": "Included"
            },
            {
              "value": "no",
              "label": "Not included"
            },
            {
              "value": "text",
              "label": "Text only"
            }
          ],
          "default": "yes"
        },
        {
          "type": "text",
          "id": "premium_note",
          "label": "Premium — text"
        },
        {
          "type": "textarea",
          "id": "confirm_note",
          "label": "Editor note (never shown to customers)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LPS · Free vs Premium",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
