{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
-%}
<section
  id="{{ anchor }}"
  class="lps lps-showcase lps-showcase--{{ s.layout }} lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px;"
>
  <div class="lps-container">
    <div class="lps-section-head{% if s.align == 'center' %} lps-section-head--center{% endif %}">
      {% render 'lps-intro', index: s.index, eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: s.align %}
    </div>

    {%- if s.layout == 'grid' -%}
      <div class="lps-showcase__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign sizes = '(min-width: 750px) 50vw, 100vw'
            if b.wide
              assign sizes = '(min-width: 750px) 100vw, 100vw'
            endif
          -%}
          <figure class="lps-shot{% if b.wide %} lps-shot--wide{% endif %}" data-lps-reveal {{ block.shopify_attributes }}>
            <div class="lps-frame lps-frame--{{ b.frame }}">
              {% render 'lps-media', image: b.image, stock: b.image_stock, alt: b.image_alt, brief: b.image_brief, label: b.placeholder_label, ratio: b.ratio, sizes: sizes, zoom: true %}
            </div>
            {%- if b.title != blank or b.text != blank -%}
              <figcaption>
                {%- if b.title != blank -%}<p class="lps-shot__title">{{ b.title }}</p>{%- endif -%}
                {%- if b.text != blank -%}<div class="lps-rte lps-rte--sm">{{ b.text }}</div>{%- endif -%}
                {% render 'lps-confirm', note: b.confirm_note %}
              </figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="lps-showcase__rows">
        {%- assign side_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            if b.wide
              assign row = 'full'
              assign sizes = '100vw'
            else
              assign side_count = side_count | plus: 1
              assign mod = side_count | modulo: 2
              if mod == 1
                assign row = 'left'
              else
                assign row = 'right'
              endif
              assign sizes = '(min-width: 990px) 62vw, 100vw'
            endif
          -%}
          <div class="lps-showcase__row lps-showcase__row--{{ row }}" {{ block.shopify_attributes }}>
            <div class="lps-showcase__visual" data-lps-reveal>
              <div class="lps-frame lps-frame--{{ b.frame }}">
                {% render 'lps-media', image: b.image, stock: b.image_stock, alt: b.image_alt, brief: b.image_brief, label: b.placeholder_label, ratio: b.ratio, sizes: sizes, zoom: true %}
              </div>
            </div>
            <div class="lps-showcase__text">
              {% render 'lps-intro', eyebrow: b.eyebrow, heading: b.title, heading_tag: 'h3', heading_size: 'md' %}
              <div>
                {%- if b.text != blank -%}
                  <div class="lps-rte" data-lps-reveal>{{ b.text }}</div>
                {%- endif -%}
                {% render 'lps-confirm', note: b.confirm_note %}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.footnote != blank -%}
      <p class="lps-note" style="margin-top: 2.5rem;">{{ s.footnote }}</p>
    {%- endif -%}
  </div>
</section>

