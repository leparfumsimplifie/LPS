{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
  assign columns = s.columns | append: ''
  case s.columns
    when 2
      assign sizes = '(min-width: 750px) 50vw, 85vw'
    when 4
      assign sizes = '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 85vw'
    else
      assign sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw'
  endcase
-%}
<section
  id="{{ anchor }}"
  class="lps lps-panels{% if s.stagger %} lps-panels--stagger{% endif %}{% if s.scroll_mobile %} lps-panels--scroll-mobile{% endif %} lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px; --lps-panel-ratio: {{ s.image_ratio }};"
>
  <div class="lps-container">
    <div class="lps-section-head{% if s.align == 'center' %} lps-section-head--center{% endif %}">
      {% render 'lps-intro',
        index: s.index,
        eyebrow: s.eyebrow,
        heading: s.heading,
        text: s.text,
        align: s.align
      %}
      {%- if s.link_label != blank and s.align != 'center' -%}
        <a class="lps-link" href="{{ s.link | default: '#' }}">{{ s.link_label }}{% render 'lps-icon', icon: 'arrow' %}</a>
      {%- endif -%}
    </div>

    <div class="lps-panels__grid lps-panels__grid--{{ columns }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign link = b.link
          if link == blank and b.product != blank
            assign link = b.product.url
          endif
        -%}
        <article class="lps-panel" role="listitem" data-lps-reveal {{ block.shopify_attributes }}>
          {% render 'lps-media', image: b.image, stock: b.image_stock, alt: b.image_alt, brief: b.image_brief, label: b.placeholder_label, sizes: sizes %}
          <div class="lps-panel__body">
            {%- if s.show_index -%}
              <span class="lps-panel__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
            <h3 class="lps-heading lps-heading--sm">
              {%- if link != blank -%}
                <a class="lps-panel__link" href="{{ link }}">{{ b.title }}</a>
              {%- else -%}
                {{ b.title }}
              {%- endif -%}
            </h3>
            {%- if b.text != blank -%}
              <div class="lps-rte lps-rte--sm">{{ b.text }}</div>
            {%- endif -%}
            {%- if b.link_label != blank or b.product != blank -%}
              <div class="lps-panel__meta">
                {%- if b.link_label != blank -%}
                  <span class="lps-link" aria-hidden="true">{{ b.link_label }}{% render 'lps-icon', icon: 'arrow' %}</span>
                {%- endif -%}
                {%- if b.product != blank and b.show_price -%}
                  <span class="lps-panel__price">{{ b.product.price | money }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            {% render 'lps-confirm', note: b.confirm_note %}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LPS · Editorial panels",
  "tag": "div",
  "class": "lps-section",
  "settings": [
    {
      "type": "text",
