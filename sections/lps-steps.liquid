          "default": "Step"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "textarea",
          "id": "confirm_note",
          "label": "Editor note (never shown to customers)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LPS · Steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
