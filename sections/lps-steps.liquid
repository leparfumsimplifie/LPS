{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
  assign cols = section.blocks.size
  if cols > 4
    assign cols = 4
  elsif cols < 1
    assign cols = 1
  endif
-%}
<section
  id="{{ anchor }}"
  class="lps lps-steps lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px; --lps-cols: {{ cols }};"
>
  <div class="lps-container">
    <div class="lps-section-head{% if s.align == 'center' %} lps-section-head--center{% endif %}">
      {% render 'lps-intro', index: s.index, eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: s.align %}
    </div>

    <ol class="lps-steps__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="lps-step" data-lps-reveal {{ block.shopify_attributes }}>
          {%- if b.image != blank or b.image_brief != blank -%}
            {% render 'lps-media', image: b.image, alt: b.image_alt, brief: b.image_brief, label: b.placeholder_label, ratio: '4 / 3', sizes: '(min-width: 750px) 25vw, 100vw' %}
          {%- endif -%}
          <span class="lps-step__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="lps-heading lps-heading--sm">{{ b.title }}</h3>
          {%- if b.text != blank -%}
            <div class="lps-rte lps-rte--sm">{{ b.text }}</div>
          {%- endif -%}
          {% render 'lps-confirm', note: b.confirm_note %}
        </li>
      {%- endfor -%}
    </ol>

    {%- if s.footnote != blank -%}
      <div class="lps-rte lps-rte--sm" style="margin-top: 2rem; max-width: 46rem;">{{ s.footnote }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LPS · Steps",
  "tag": "div",
  "class": "lps-section",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Section number"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How access works"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "start"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "charcoal",
          "label": "Charcoal"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Optional. Lets buttons link to this section, e.g. #curriculum"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt text"
        },
        {
          "type": "textarea",
          "id": "image_brief",
          "label": "Image brief (shown until an image is added)"
        },
        {
          "type": "text",
          "id": "placeholder_label",
          "label": "Placeholder label",
          "default": "Screenshot required"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "textarea",
          "id": "confirm_note",
          "label": "Editor note (never shown to customers)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LPS · Steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
