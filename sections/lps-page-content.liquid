{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign current = request.path
-%}
<section
  id="{{ section.id | handleize }}"
  class="lps lps-page lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px;"
>
  <div class="lps-container">
    <div class="lps-page__grid">
      <aside class="lps-page__aside">
        {%- if section.blocks.size > 0 -%}
          <nav class="lps-page__nav" aria-label="{{ s.nav_heading | escape }}">
            <p class="lps-eyebrow">{{ s.nav_heading }}</p>
            <ul role="list">
              {%- for block in section.blocks -%}
                {%- assign link = block.settings.link -%}
                <li {{ block.shopify_attributes }}>
                  <a href="{{ link | default: '#' }}"{% if link == current %} aria-current="page"{% endif %}>{{ block.settings.label }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
        {%- if s.help_text != blank -%}
          <div class="lps-page__help lps-rte lps-rte--sm">{{ s.help_text }}</div>
        {%- endif -%}
      </aside>

      <article class="lps-page__body">
        {%- if s.eyebrow != blank -%}<p class="lps-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.show_title -%}<h1 class="lps-heading lps-heading--lg">{{ page.title | default: 'Page title' }}</h1>{%- endif -%}
        {%- if s.intro != blank -%}<div class="lps-rte lps-page__intro">{{ s.intro }}</div>{%- endif -%}
        <div class="lps-prose">
          {%- if page.content != blank -%}
            {{ page.content }}
          {%- elsif request.design_mode -%}
            <p>Add this page's text in Shopify admin: Online Store → Pages.</p>
          {%- endif -%}
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LPS · Page content",
  "tag": "div",
  "class": "lps-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Policies"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction (optional)"
    },
    {
      "type": "paragraph",
      "content": "The main text comes from the page itself: Online Store → Pages → choose the page."
    },
    {
      "type": "text",
      "id": "nav_heading",
      "label": "Side menu heading",
      "default": "Information"
    },
    {
      "type": "richtext",
      "id": "help_text",
      "label": "Help box",
      "default": "<p>Questions? <a href=\"/pages/contact\">Contact us</a> and include the email address associated with your order.</p>"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "charcoal",
          "label": "Charcoal"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Menu link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LPS · Page content"
    }
  ]
}
{% endschema %}
