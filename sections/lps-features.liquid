        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "charcoal",
          "label": "Charcoal"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
