{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
  assign sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
  if s.columns == 2
    assign sizes = '(min-width: 750px) 50vw, 100vw'
  endif
-%}
<section
  id="{{ anchor }}"
  class="lps lps-features lps-features--{{ s.style }} lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px;"
>
  <div class="lps-container">
    <div class="lps-section-head{% if s.align == 'center' %} lps-section-head--center{% endif %}">
      {% render 'lps-intro', index: s.index, eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: s.align %}
    </div>

    <ul class="lps-features__grid lps-features__grid--{{ s.columns }}" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="lps-feature" data-lps-reveal {{ block.shopify_attributes }}>
          {%- if b.image != blank or b.image_stock != 'none' or request.design_mode and b.image_brief != blank -%}
            {% render 'lps-media', image: b.image, stock: b.image_stock, alt: b.image_alt, brief: b.image_brief, label: b.placeholder_label, ratio: '3 / 2', sizes: sizes %}
          {%- endif -%}
          {%- if s.show_index or b.status != 'none' -%}
            <div class="lps-feature__top">
              {%- if s.show_index -%}
                <span class="lps-feature__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {%- else -%}
                <span></span>
              {%- endif -%}
              {%- case b.status -%}
                {%- when 'available' -%}
                  <span class="lps-badge lps-badge--available">{{ s.available_label }}</span>
                {%- when 'soon' -%}
                  <span class="lps-badge lps-badge--soon">{{ s.soon_label }}</span>
              {%- endcase -%}
            </div>
          {%- endif -%}
          <h3 class="lps-heading lps-heading--sm">{{ b.title }}</h3>
          {%- if b.text != blank -%}
            <div class="lps-rte lps-rte--sm">{{ b.text }}</div>
          {%- endif -%}
          {% render 'lps-confirm', note: b.confirm_note %}
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.footnote != blank or s.button_label != blank -%}
      <div class="lps-section-head" style="margin: 2.5rem 0 0; align-items: center;">
        {%- if s.footnote != blank -%}
          <div class="lps-rte lps-rte--sm" style="max-width: 46rem;">{{ s.footnote }}</div>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="lps-btn{% if s.button_style == 'secondary' %} lps-btn--secondary{% endif %}" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {% render 'lps-confirm', note: s.confirm_note %}
  </div>
</section>

{% schema %}
{
  "name": "LPS · Feature grid",
  "tag": "div",
  "class": "lps-section",
  "settings": [
    {
      "type": "text",
      "id": "index",
