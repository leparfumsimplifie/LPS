{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
  assign form_id = 'LpsBrief-' | append: section.id
  assign has_media = false
  if s.image != blank or s.image_stock != 'none'
    assign has_media = true
  endif
-%}
<section
  id="{{ anchor }}"
  class="lps lps-brief{% if has_media %} lps-brief--media{% endif %} lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px;"
>
  <div class="lps-container">
    <div class="lps-brief__grid">
      <div class="lps-brief__aside">
        {% render 'lps-intro', eyebrow: s.eyebrow, heading: s.heading, text: s.text %}
        {%- if has_media -%}
          <div class="lps-brief__media" data-lps-reveal>
            {% render 'lps-media', image: s.image, stock: s.image_stock, alt: s.image_alt, ratio: '4 / 5', sizes: '(min-width: 990px) 33vw, 100vw' %}
          </div>
        {%- endif -%}
      </div>

      <div class="lps-brief__panel">
        {%- form 'contact', id: form_id, class: 'lps-brief__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="lps-brief__success" role="status" tabindex="-1" autofocus>
              <p class="lps-heading lps-heading--md">{{ s.success_heading }}</p>
              <div class="lps-rte">{{ s.success_text }}</div>
            </div>
          {%- else -%}
            <input type="hidden" name="contact[Form]" value="{{ s.form_name | escape }}">

            {%- if form.errors -%}
              <div class="lps-brief__errors" role="alert">
                <p><strong>Please check the following:</strong></p>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <lps-stepper{% if s.show_steps %} data-steps{% endif %}>
              <p class="lps-brief__progress" data-progress hidden aria-live="polite"></p>
              {%- for block in section.blocks -%}
                {%- if block.type == 'step' or forloop.first -%}
                  {%- assign step_start = forloop.index0 -%}
                  <fieldset class="lps-brief__step" data-step {{ block.shopify_attributes }}>
                    {%- if block.type == 'step' -%}
                      <legend class="lps-brief__legend">{{ block.settings.title }}</legend>
                      {%- if block.settings.intro != blank -%}<p class="lps-brief__intro">{{ block.settings.intro }}</p>{%- endif -%}
                    {%- endif -%}
                    <div class="lps-brief__fields">
                      {%- for q in section.blocks offset: step_start -%}
                        {%- if forloop.first and q.type == 'step' -%}{%- continue -%}{%- endif -%}
                        {%- if q.type == 'step' -%}{%- break -%}{%- endif -%}
                        {%- assign b = q.settings -%}
                    {%- liquid
                      assign qid = 'q-' | append: q.id
                      assign choices = b.options | newline_to_br | split: '<br />'
                      case b.kind
                        when 'name'
                          assign field = 'contact[name]'
                        when 'email'
                          assign field = 'contact[email]'
                        when 'phone'
                          assign field = 'contact[phone]'
                        else
                          assign field = 'contact[' | append: b.label | append: ']'
                      endcase
                      assign value = ''
                      if b.kind == 'email'
                        assign value = form.email
                      endif
                    -%}
                    <div class="lps-field lps-field--{{ b.width }} lps-field--{{ b.kind }}" {{ q.shopify_attributes }}>
                      {%- case b.kind -%}
                        {%- when 'radio', 'checkboxes', 'scale' -%}
                          <fieldset class="lps-field__group">
                            <legend class="lps-field__label">{{ b.label }}{% if b.required %} <span aria-hidden="true">*</span>{% endif %}</legend>
                            {%- if b.help != blank -%}<p class="lps-field__help">{{ b.help }}</p>{%- endif -%}
                            <div class="lps-choices{% if b.kind == 'scale' %} lps-choices--scale{% endif %}">
                              {%- for raw_choice in choices -%}
                                {%- assign choice = raw_choice | strip -%}
                                {%- if choice == blank -%}{%- continue -%}{%- endif -%}
                                {%- if b.kind == 'checkboxes' -%}
                                  <label class="lps-choice">
                                    <input type="checkbox" name="contact[{{ b.label | escape }}: {{ choice | escape }}]" value="Yes">
                                    <span>{{ choice }}</span>
                                  </label>
                                {%- else -%}
                                  <label class="lps-choice">
                                    <input type="radio" name="{{ field | escape }}" value="{{ choice | escape }}"{% if b.required and forloop.first %} required{% endif %}>
                                    <span>{{ choice }}</span>
                                  </label>
                                {%- endif -%}
                              {%- endfor -%}
                            </div>
                          </fieldset>
                        {%- when 'select' -%}
                          <label class="lps-field__label" for="{{ qid }}">{{ b.label }}{% if b.required %} <span aria-hidden="true">*</span>{% endif %}</label>
                          {%- if b.help != blank -%}<p class="lps-field__help" id="{{ qid }}-help">{{ b.help }}</p>{%- endif -%}
                          <select class="lps-input" id="{{ qid }}" name="{{ field | escape }}"{% if b.required %} required{% endif %}{% if b.help != blank %} aria-describedby="{{ qid }}-help"{% endif %}>
                            <option value="">{{ b.placeholder | default: 'Select' }}</option>
                            {%- for raw_choice in choices -%}
                              {%- assign choice = raw_choice | strip -%}
                              {%- if choice != blank -%}<option value="{{ choice | escape }}">{{ choice }}</option>{%- endif -%}
                            {%- endfor -%}
                          </select>
                        {%- when 'textarea' -%}
                          <label class="lps-field__label" for="{{ qid }}">{{ b.label }}{% if b.required %} <span aria-hidden="true">*</span>{% endif %}</label>
                          {%- if b.help != blank -%}<p class="lps-field__help" id="{{ qid }}-help">{{ b.help }}</p>{%- endif -%}
                          <textarea class="lps-input" id="{{ qid }}" name="{{ field | escape }}" rows="4" placeholder="{{ b.placeholder | escape }}"{% if b.required %} required{% endif %}{% if b.help != blank %} aria-describedby="{{ qid }}-help"{% endif %}></textarea>
                        {%- else -%}
                          {%- liquid
                            case b.kind
                              when 'email'
                                assign input_type = 'email'
                                assign autocomplete = 'email'
                              when 'phone'
                                assign input_type = 'tel'
                                assign autocomplete = 'tel'
                              when 'name'
                                assign input_type = 'text'
                                assign autocomplete = 'name'
                              when 'url'
                                assign input_type = 'text'
                                assign autocomplete = 'url'
                              else
                                assign input_type = 'text'
                                assign autocomplete = 'off'
                            endcase
                          -%}
                          <label class="lps-field__label" for="{{ qid }}">{{ b.label }}{% if b.required or b.kind == 'email' %} <span aria-hidden="true">*</span>{% endif %}</label>
                          {%- if b.help != blank -%}<p class="lps-field__help" id="{{ qid }}-help">{{ b.help }}</p>{%- endif -%}
                          <input class="lps-input" type="{{ input_type }}" id="{{ qid }}" name="{{ field | escape }}" autocomplete="{{ autocomplete }}" placeholder="{{ b.placeholder | escape }}"{% if b.required or b.kind == 'email' %} required{% endif %}{% if b.kind == 'email' and value != blank %} value="{{ value | escape }}"{% endif %}{% if b.help != blank %} aria-describedby="{{ qid }}-help"{% endif %}>
                      {%- endcase -%}
                    </div>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endif -%}
              {%- endfor -%}

              <div class="lps-brief__nav">
                <button type="button" class="lps-btn lps-btn--secondary" data-back hidden>{{ s.back_label }}</button>
                <button type="button" class="lps-btn" data-next hidden>{{ s.next_label }}</button>
                <button type="submit" class="lps-btn" data-submit>{{ s.submit_label }}</button>
              </div>
            </lps-stepper>

            {%- if s.privacy_text != blank -%}
              <div class="lps-brief__privacy lps-rte lps-rte--sm">{{ s.privacy_text }}</div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

