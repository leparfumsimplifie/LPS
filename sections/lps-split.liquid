{%- render 'lps-assets' -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
  assign items = section.blocks | where: 'type', 'item'
  assign annotations = section.blocks | where: 'type', 'annotation'
  assign has_pair = false
  if s.image_2 != blank or s.image_2_brief != blank
    assign has_pair = true
  endif
  assign sizes = '(min-width: 990px) 50vw, 100vw'
  if s.media_width == 'wide'
    assign sizes = '(min-width: 990px) 58vw, 100vw'
  endif
-%}
<section
  id="{{ anchor }}"
  class="lps lps-split lps-split--media-{{ s.media_position }}{% if s.media_width == 'wide' %} lps-split--wide-media{% endif %}{% if s.sticky_media %} lps-split--sticky{% endif %}{% if s.bleed_mobile %} lps-split--bleed-mobile{% endif %} lps-tone--{{ s.tone }}"
  style="--lps-pt: {{ s.padding_top }}px; --lps-pb: {{ s.padding_bottom }}px;"
>
  <div class="lps-container">
    <div class="lps-split__grid">
      <div class="lps-split__media" data-lps-reveal>
        <figure class="lps-figure">
          <div class="lps-split__media-stack{% if has_pair %} lps-split__media-stack--pair{% endif %}">
            <div class="lps-annotated">
              {% render 'lps-media', image: s.image, alt: s.image_alt, brief: s.image_brief, label: s.placeholder_label, ratio: s.image_ratio, sizes: sizes, zoom: s.zoom %}
              {%- for block in annotations -%}
                <span
                  class="lps-annotation"
                  style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;"
                  {{ block.shopify_attributes }}
                >
                  <span class="lps-annotation__dot">{{ forloop.index }}</span>
                  <span class="lps-annotation__label">{{ block.settings.label }}</span>
                </span>
              {%- endfor -%}
            </div>
            {%- if has_pair -%}
              {% render 'lps-media', image: s.image_2, alt: s.image_2_alt, brief: s.image_2_brief, label: s.placeholder_label, ratio: '3 / 4', sizes: '(min-width: 990px) 20vw, 40vw' %}
            {%- endif -%}
          </div>
          {%- if annotations.size > 0 -%}
            <ol class="lps-annotation-key">
              {%- for block in annotations -%}
                <li>{{ forloop.index }}. {{ block.settings.label }}</li>
              {%- endfor -%}
            </ol>
          {%- endif -%}
          {%- if s.caption != blank -%}
            <figcaption class="lps-media__caption">{{ s.caption }}</figcaption>
          {%- endif -%}
        </figure>
      </div>

      <div class="lps-split__body">
        {% render 'lps-intro',
          index: s.index,
          eyebrow: s.eyebrow,
          heading: s.heading,
          heading_size: s.heading_size,
          text: s.text
        %}

        {%- if items.size > 0 -%}
          <ul class="lps-list{% if s.list_style == 'plain' %} lps-list--plain{% endif %}" role="list" data-lps-reveal>
            {%- for block in items -%}
              <li class="lps-list__item" {{ block.shopify_attributes }}>
                {%- if s.list_style != 'plain' -%}
                  <span class="lps-list__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {%- endif -%}
                <p class="lps-list__title">{{ block.settings.title }}</p>
                {%- if block.settings.text != blank -%}
                  <p class="lps-list__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.closing_text != blank -%}
          <div class="lps-rte lps-rte--sm" data-lps-reveal>{{ s.closing_text }}</div>
        {%- endif -%}

        {%- if s.button_label != blank -%}
          <div class="lps-actions" data-lps-reveal>
            {%- if s.button_style == 'link' -%}
              <a class="lps-link" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}{% render 'lps-icon', icon: 'arrow' %}</a>
            {%- else -%}
              <a class="lps-btn{% if s.button_style == 'secondary' %} lps-btn--secondary{% endif %}" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {% render 'lps-confirm', note: s.confirm_note %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LPS · Image with text",
  "tag": "div",
  "class": "lps-section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "index",
      "label": "Section number",
      "info": "Optional, e.g. 02"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "md",
          "label": "Medium"
        }
      ],
      "default": "lg"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "list_style",
      "label": "List style",
      "options": [
        {
          "value": "numbered",
          "label": "Numbered"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ],
      "default": "numbered"
    },
    {
      "type": "richtext",
      "id": "closing_text",
      "label": "Text after list"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Solid"
        },
        {
          "value": "secondary",
          "label": "Outline"
        },
        {
          "value": "link",
          "label": "Text link"
        }
      ],
      "default": "link"
    },
    {
      "type": "header",
      "content": "Photography"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Main image alt text"
    },
    {
      "type": "textarea",
      "id": "image_brief",
      "label": "Main image brief (shown until an image is added)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Main image shape",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        },
        {
          "value": "16 / 10",
          "label": "Wide (screenshots)"
        },
        {
          "value": "natural",
          "label": "Original shape"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "zoom",
      "label": "Allow visitors to enlarge the main image",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Secondary detail image (optional)"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Secondary image alt text"
    },
    {
      "type": "textarea",
      "id": "image_2_brief",
      "label": "Secondary image brief"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "Photography required"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position on desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "Image width",
      "options": [
        {
          "value": "equal",
          "label": "Equal to text"
        },
        {
          "value": "wide",
          "label": "Wider than text"
        }
      ],
      "default": "equal"
    },
    {
      "type": "checkbox",
      "id": "sticky_media",
      "label": "Keep image in view while text scrolls",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bleed_mobile",
      "label": "Edge-to-edge image on mobile",
      "default": true
    },
    {
      "type": "textarea",
      "id": "confirm_note",
      "label": "Editor note (never shown to customers)",
      "info": "Visible only inside the theme editor."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "charcoal",
          "label": "Charcoal"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Optional. Lets buttons link to this section, e.g. #curriculum"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "List item"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    },
    {
      "type": "annotation",
      "name": "Image annotation",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Annotation"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LPS · Image with text"
    }
  ]
}
{% endschema %}
